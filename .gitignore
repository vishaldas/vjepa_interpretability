# ---- big derived artifacts (regenerable; the cache alone is 5.4 GB) ----
artifacts/cache/
artifacts/results/
artifacts/*.log
# NOTE: artifacts/ is deliberately NOT ignored wholesale — git cannot re-include
# files inside an ignored directory, and artifacts/figures + artifacts/deck are
# the deliverables.

outputs/
checkpoints/
features/
*.pt
*.pth
*.ckpt
*.npz

# ---- environments and caches ----
.venv/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/

# ---- secrets — never commit ----
*token*.env
.env
hf_token*
*.pem
*.key

# ---- supplied material — kept locally, never committed ----
# The clips, the task statement and the dataset reference belong to World
# Mechanics. They stay on disk so the pipeline runs without re-downloading,
# but they are not redistributed here. See the README for where to get them.
data/
TASK.md
DATA.md

# ---- macOS ----
.DS_Store
